# Скопируйте этот файл в .env и при необходимости измените значения.
# .env НЕ попадает в git (см. .gitignore) — там же удобно хранить секреты.

# Порт, на котором запускается сервер
PORT=3000

# Путь к файлу базы данных SQLite.
# По умолчанию (если не указать) — ./shopkz.db в корне проекта.
# SHOPKZ_DB_PATH=./shopkz.db

# Секрет для подписи сессионных cookie (в server.js сейчас захардкожен для простоты —
# для боевого использования вынесите его сюда и замените в server.js на process.env.SESSION_SECRET).
SESSION_SECRET=shopkz-demo-secret-change-me
