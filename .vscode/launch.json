{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ShopKZ: запустить сервер (отладка)",
      "program": "${workspaceFolder}/server.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ShopKZ: Unit-тесты (Jest)",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["tests/unit", "--runInBand"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ShopKZ: Integration-тесты (Jest)",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["tests/integration", "--runInBand"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ShopKZ: System-тест",
      "program": "${workspaceFolder}/tests/system/system.test.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
